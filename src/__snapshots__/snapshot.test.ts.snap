exports[`what ends up in the DOM > emits the same stylesheet 1`] = `
"
.octo-strip{animation:octo-strip var(--octo-swim,.9s) steps(8) infinite}
@keyframes octo-strip{from{transform:translateX(0)}to{transform:translateX(-240px)}}
.octo-bob{transform:translateY(0px);animation:octo-bob var(--octo-swim,.9s) linear infinite}
@keyframes octo-bob{0%,24.99%{transform:translateY(0px)}25%,49.99%{transform:translateY(1px)}50%,62.49%{transform:translateY(2px)}62.5%,87.49%{transform:translateY(1px)}87.5%,100%{transform:translateY(0px)}}
.octo-lid{opacity:0;animation:octo-lid var(--octo-blink,4.6s) linear infinite}
@keyframes octo-lid{0%,95.49%{opacity:0}95.5%,97.99%{opacity:1}98%,100%{opacity:0}}
.octo-look{opacity:0;animation-duration:var(--octo-glance,7.3s);animation-timing-function:linear;animation-iteration-count:infinite}
.octo-look-left{animation-name:octo-look-left}
.octo-look-right{animation-name:octo-look-right}
@keyframes octo-look-left{0%,20.99%{opacity:0}21%,33.99%{opacity:1}34%,100%{opacity:0}}
@keyframes octo-look-right{0%,57.99%{opacity:0}58%,70.99%{opacity:1}71%,100%{opacity:0}}
.octo-bubble{opacity:0}
.octo-bubble-0{animation:octo-bubble-0 calc(3.2s / var(--octo-rate,1)) steps(14) calc(0s / var(--octo-rate,1)) infinite}@keyframes octo-bubble-0{from{opacity:.85;transform:translateY(0)}to{opacity:0;transform:translateY(-14px)}}.octo-bubble-1{animation:octo-bubble-1 calc(2.6s / var(--octo-rate,1)) steps(11) calc(1.1s / var(--octo-rate,1)) infinite}@keyframes octo-bubble-1{from{opacity:.85;transform:translateY(0)}to{opacity:0;transform:translateY(-11px)}}.octo-bubble-2{animation:octo-bubble-2 calc(3.8s / var(--octo-rate,1)) steps(16) calc(2s / var(--octo-rate,1)) infinite}@keyframes octo-bubble-2{from{opacity:.85;transform:translateY(0)}to{opacity:0;transform:translateY(-16px)}}
@keyframes octo-rest{0%,100%{opacity:1}50%{opacity:.45}}
@media (prefers-reduced-motion:reduce){
.octo-strip,.octo-bob,.octo-lid,.octo-look,.octo-bubble{animation:none}
.octo-bubble{opacity:0}
.octo-body{animation:octo-rest 1.8s ease-in-out infinite}
}
"
`;
