{
  "name": "octoloader",
  "version": "0.1.0",
  "description": "A pixel-art octopus that swims while you wait. Dependency-free loading indicator for React or plain HTML — colour and monochrome, determinate and indeterminate.",
  "license": "MIT",
  "author": "Michal Strnadel (https://michalstrnadel.com)",
  "homepage": "https://github.com/michalstrnadel/octoloader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michalstrnadel/octoloader.git"
  },
  "bugs": {
    "url": "https://github.com/michalstrnadel/octoloader/issues"
  },
  "type": "module",
  "customElements": "custom-elements.json",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "./dist/element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./sprite": {
      "types": "./dist/sprite.d.ts",
      "default": "./dist/sprite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "cem": "npx --yes @custom-elements-manifest/analyzer@0.11.0 analyze",
    "docs": "npm run build && node scripts/export-sprite.mjs && python3 scripts/render-docs.py",
    "dev": "tsup --watch",
    "prepare": "tsup",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run cem",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,yml,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md,yml,html}\"",
    "lock": "npm install --package-lock-only --os=linux --cpu=x64"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "serve": "^14.2.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "loader",
    "loading",
    "loading-indicator",
    "loading-spinner",
    "spinner",
    "progress",
    "progressbar",
    "skeleton",
    "pixel-art",
    "sprite",
    "octopus",
    "mascot",
    "animation",
    "css-animation",
    "svg",
    "react",
    "react-component",
    "web-component",
    "custom-element",
    "typescript",
    "accessibility",
    "a11y",
    "prefers-reduced-motion",
    "zero-dependency",
    "dark-mode"
  ]
}
